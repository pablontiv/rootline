version: 2
scope:
  match: "*.md"

schema:
  titulo:
    type: string
    source: body.h1

  estado:
    type: enum
    required:
      match: ["T*"]
    match: ["O*", "T*"]
    values: [Pending, Specified, In Progress, Completed, Blocked, On Hold, Obsolete]

  tipo:
    type: enum
    required:
      match: ["O*", "T*"]
    match: ["O*", "T*"]
    values: [outcome, task]

  id:
    type: sequence
    match:
      "O*": { prefix: O, digits: 2 }
      "T*": { prefix: T, digits: 3 }

  is_done:
    type: boolean
    severity: off

derive:
  is_done: "estado in ['Completed', 'Obsolete']"

links:
  blocked_by:
    target: '^(\./|\.\./|.*/)T[0-9]{3}-[^/]+\.md$'
    value_field: estado
  reference:
    target: ".*"

validate:
  - field: tipo
    rule: non_empty

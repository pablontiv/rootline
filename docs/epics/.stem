version: 1

schema:
  id:
    type: sequence
    prefix: E
    digits: 2
  estado:
    type: enum
    values:
      - Pending
      - In Progress
      - Specified
      - Completado
      - Diferida
      - Bloqueada
    required: true
  tipo:
    type: enum
    values:
      # IaC
      - servicio-docker
      - modulo-sistema
      - operacion-sistema
      - lxc
      - vm
      - modulo-infraestructura
      - host-script
      - instance-script
      # Software
      - software-module
      - software-test
      - ci-cd
      # General
      - documentation
      # Framework
      - feature
      - historia
    severity: warn
  cliente:
    type: string
  ejecutable_en:
    type: string

structural:
  subdirs:
    require_index: README.md
    min_children: 2
    severity: warn

links:
  allowed: [blocks, reference]
  blocks:
    target: "^T\\d{3}-"
    field: blocked_by

derive:
  estado: |
    blocked_by != nil && len(blocked_by) > 0 && !all(blocked_by, {# == "Completado"}) ? "Bloqueada" : estado

validate:
  - rule: requires
    if: { tipo: "software-module" }
    then: { fields: [ejecutable_en] }
  - rule: requires
    if: { tipo: "ci-cd" }
    then: { fields: [ejecutable_en] }

aggregate:
  estado: |
    all(descendants, {.estado == "Completado"}) ? "Completado" :
    any(descendants, {.estado == "Bloqueada"}) ? "Bloqueada" :
    any(descendants, {.estado == "In Progress"}) ? "In Progress" :
    estado

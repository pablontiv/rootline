version: 1

schema:
  id:
    type: sequence
    prefix: E
    digits: 2

levels:
  epic:
    match: "E*"
    children: [feature]
  feature:
    match: "F*"
    children: [story]
    schema:
      tipo:
        type: enum
        values: [servicio-docker, modulo-sistema, operacion-sistema, lxc, vm, modulo-infraestructura, host-script, instance-script, software-module, software-test, ci-cd, documentation, feature, historia]
        severity: warn
  story:
    match: "S*"
    children: [task]
    schema:
      cliente:
        type: string
        severity: error
  task:
    match: "T*"
    children: []
    schema:
      ejecutable_en:
        type: string
        severity: error
      hold:
        type: string
        severity: error

structural:
  subdirs:
    require_index: README.md
    min_children: 1
    severity: warn

links:
  allowed: [blocks, reference]
  blocks:
    target: "^T\\d{3}-"
    field: blocked_by

derive:
  estado: |
    hold != nil ? "On Hold" : blocked_by != nil && len(blocked_by) > 0 && !all(blocked_by, {# == "Completed"}) ? "Blocked" : estado

aggregate:
  estado: |
    all(descendants, {.estado == "Completed"}) ? "Completed" :
    any(descendants, {.estado == "Blocked"}) ? "Blocked" :
    any(descendants, {.estado == "On Hold"}) ? "On Hold" :
    any(descendants, {.estado == "In Progress"}) ? "In Progress" :
    any(descendants, {.estado == "Specified"}) ? "Specified" :
    "Pending"

validate:
  - if:
      tipo: software-module
    rule: requires
    severity: error
    then:
      fields:
          - ejecutable_en
  - if:
      tipo: ci-cd
    rule: requires
    severity: error
    then:
      fields:
          - ejecutable_en

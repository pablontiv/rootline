version: 1

schema:
  id:
    type: sequence
    prefix: E
    digits: 2
  estado:
    type: enum
    values:
      - Pending
      - In Progress
      - Specified
      - Completado
      - Diferida
      - Bloqueada
    required: true
  tipo:
    type: enum
    values:
      # IaC
      - servicio-docker
      - modulo-sistema
      - operacion-sistema
      - lxc
      - vm
      - modulo-infraestructura
      - host-script
      - instance-script
      # Software
      - software-module
      - software-test
      - ci-cd
      # General
      - documentation
      # Framework
      - feature
      - historia
    severity: warn
  cliente:
    type: string
  ejecutable_en:
    type: string

links:
  allowed: [blocks, reference]
  blocks:
    target: "T*"

validate:
  - rule: requires
    if: { tipo: "software-module" }
    then: { fields: [ejecutable_en] }
  - rule: requires
    if: { tipo: "ci-cd" }
    then: { fields: [ejecutable_en] }

schema:
  id:
    type: sequence
    prefix: S
    digits: 3
  cliente:
    type: string
    severity: error
  tipo:
    type: enum
    values: [servicio-docker, modulo-sistema, operacion-sistema, lxc, vm, modulo-infraestructura, host-script, instance-script, software-module, software-test, ci-cd, documentation, feature, historia]
    severity: warn

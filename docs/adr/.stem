version: 2
root: true
schema:
    tipo:
        type: enum
        values: [adr]
        required: true
    estado:
        type: enum
        values: [proposed, accepted, superseded]
        required: true
    fecha:
        type: string
        required: true
    contexto:
        type: string
        required: true
    decision:
        type: string
        required: true
    consecuencias:
        type: string
        required: true

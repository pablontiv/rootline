#!/bin/sh
# Repository-local, checksum-pinned Dagu bootstrap. Runtime bytes stay ignored.
set -eu
REPO=$(CDPATH= cd -P "$(dirname "$0")/../../.." && pwd -P)
DAGU_HOME="$REPO/.workspace/dagu"
export DAGU_HOME
[ ! -L "$REPO/.workspace" ] && [ ! -L "$DAGU_HOME" ] || { echo 'refusing symlinked Dagu home' >&2; exit 1; }
version=$(cat "$DAGU_HOME/VERSION")
[ "$version" = 2.19.2 ] || { echo 'unsupported Dagu pin' >&2; exit 1; }
case $(uname -s) in Darwin) os=darwin ;; Linux) os=linux ;; *) echo 'Dagu supports macOS and Linux here' >&2; exit 1 ;; esac
case $(uname -m) in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=amd64 ;; *) echo 'unsupported Dagu architecture' >&2; exit 1 ;; esac
case "$os-$arch" in
    darwin-arm64)
        archive_expected=1e0381aaf43b875a772719514057508bb96674473191aada9c0889e18e4419a4
        binary_expected=39a05714aa0a3f7006c19cbcbfafc5924c0e901fd821c0dbf59006fd76a4530d ;;
    darwin-amd64)
        archive_expected=2e8d236b559786cd285c829bc176a78615e4c94900451c1fcc62b76ab5deb7a6
        binary_expected=f182a334db398f6fc0a66df1eeefd80604187f3f35fa8397e222a25d4d336043 ;;
    linux-arm64)
        archive_expected=8931188a8d40d314346cb3f36d0b26c615b0b6c490297801e82811d14856556d
        binary_expected=f581f8197668fb9d4b8f144313770438292a1537766b19fca401b299a246e17d ;;
    linux-amd64)
        archive_expected=df2b3d7d27c8e9b206e061e0d6b082ca7d3c3bd205d60453577a955e8991998f
        binary_expected=48d864cf002db6d18a1f82d86f6e19c8fe3405ae9b6be8ca9b73400ad00d1444 ;;
esac
sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
    else shasum -a 256 "$1" | cut -d ' ' -f 1; fi
}
[ ! -L "$DAGU_HOME/data" ] || { echo 'refusing symlinked Dagu data' >&2; exit 1; }
mkdir -p "$DAGU_HOME/data/bootstrap"
base="$DAGU_HOME/data/bootstrap"
[ ! -L "$base" ] || { echo 'refusing symlinked bootstrap directory' >&2; exit 1; }
cache="$base/$version-$os-$arch"
if [ ! -d "$cache" ]; then
    lock="$base/download.lock"
    mkdir "$lock" 2>/dev/null || { echo 'Dagu bootstrap already in progress; retry after it finishes' >&2; exit 1; }
    stage=''
    trap '[ -z "$stage" ] || rm -rf "$stage"; rmdir "$lock"' 0
    trap 'exit 1' HUP INT TERM
    stage=$(mktemp -d "$base/.download.XXXXXX")
    asset="dagu_${version}_${os}_${arch}.tar.gz"
    curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
        "https://github.com/dagucloud/dagu/releases/download/v$version/$asset" -o "$stage/asset.tar.gz"
    [ "$(sha256 "$stage/asset.tar.gz")" = "$archive_expected" ] || { echo 'Dagu archive checksum mismatch' >&2; exit 1; }
    # Extract only the release binary; no archive paths may escape staging.
    tar -xzf "$stage/asset.tar.gz" -C "$stage" dagu
    [ -f "$stage/dagu" ] && [ ! -L "$stage/dagu" ] || { echo 'missing regular Dagu binary' >&2; exit 1; }
    chmod 755 "$stage/dagu"
    [ "$(sha256 "$stage/dagu")" = "$binary_expected" ] || { echo 'Dagu binary checksum mismatch' >&2; exit 1; }
    rm "$stage/asset.tar.gz"
    mv "$stage" "$cache"
    stage=''
    rmdir "$lock"
    trap - 0 HUP INT TERM
fi
[ ! -L "$cache" ] && [ ! -L "$cache/dagu" ] && [ -f "$cache/dagu" ] || { echo 'invalid Dagu cache' >&2; exit 1; }
[ "$(sha256 "$cache/dagu")" = "$binary_expected" ] || { echo 'cached Dagu binary checksum mismatch' >&2; exit 1; }
exec "$cache/dagu" "$@"

#!/usr/bin/env bash
# Validate docs/epics/ before pushing if any doc files changed in the push range.
# Mirrors the docs-validate CI job to catch errors locally.

remote="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

while read local_ref local_sha remote_ref remote_sha; do
  # Skip delete pushes
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Check if any docs/epics files changed in the push range
  if git diff --name-only "$range" -- docs/epics/ 2>/dev/null | grep -q .; then
    echo "Validating docs/epics/ before push..."
    if ! rootline validate --all docs/epics/ > /dev/null 2>&1; then
      echo "rootline validate --all docs/epics/ failed. Fix errors before pushing."
      echo "Run: rootline validate --all docs/epics/"
      echo "Or:  rootline fix --all docs/epics/"
      exit 1
    fi
    echo "docs/epics/ validation passed"
  fi

  # Check if CLI code changed but docs or skills weren't updated
  if git diff --name-only "$range" -- cmd/rootline/ 2>/dev/null | grep -q .; then
    missing=""
    if ! git diff --name-only "$range" -- docs/ README.md CLAUDE.md 2>/dev/null | grep -q .; then
      missing="docs"
    fi
    if ! git diff --name-only "$range" -- .claude/skills/rootline/ 2>/dev/null | grep -q .; then
      missing="${missing:+$missing + }skills"
    fi
    if [ -n "$missing" ]; then
      echo "CLI code changed but $missing were not updated."
      echo "Run: /update-docs all"
      exit 1
    fi
  fi

done

# Sync rootline skills to ~/.claude/skills/
SKILLS_DEST="$HOME/.claude/skills"
mkdir -p "$SKILLS_DEST"
rm -rf "${SKILLS_DEST:?}/rootline"
cp -r "$REPO_ROOT/.claude/skills/rootline" "$SKILLS_DEST/rootline"
echo "rootline: synced skills → $SKILLS_DEST/rootline"

# Rebuild rootline binary so the installed version matches the pushed code
echo "Rebuilding rootline binary..."
if go build -ldflags "-X main.version=$(git describe --tags 2>/dev/null || echo dev)" -o /usr/local/bin/rootline ./cmd/rootline/ 2>&1; then
  echo "rootline rebuilt: $(rootline --version)"
else
  echo "Warning: rootline rebuild failed (push continues)"
fi

#!/usr/bin/env bash
# Validate docs/epics/ before pushing if any doc files changed in the push range.
# Mirrors the docs-validate CI job to catch errors locally.

remote="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

while read local_ref local_sha remote_ref remote_sha; do
  # Skip delete pushes
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Check if any docs/epics files changed in the push range
  if git diff --name-only "$range" -- docs/epics/ 2>/dev/null | grep -q .; then
    echo "Validating docs/epics/ before push..."
    if ! rootline validate --all docs/epics/ > /dev/null 2>&1; then
      echo "rootline validate --all docs/epics/ failed. Fix errors before pushing."
      echo "Run: rootline validate --all docs/epics/"
      echo "Or:  rootline fix --all docs/epics/"
      exit 1
    fi
    echo "docs/epics/ validation passed"
  fi

  # Check if CLI code changed but docs or skills weren't updated
  if git diff --name-only "$range" -- cmd/rootline/ 2>/dev/null | grep -q .; then
    missing=""
    if ! git diff --name-only "$range" -- docs/ README.md CLAUDE.md 2>/dev/null | grep -q .; then
      missing="docs"
    fi
    if ! git diff --name-only "$range" -- .claude/skills/rootline/ 2>/dev/null | grep -q .; then
      missing="${missing:+$missing + }skills"
    fi
    if [ -n "$missing" ]; then
      echo "CLI code changed but $missing were not updated."
      echo "Run: /update-docs all"
      exit 1
    fi
  fi

  # Check if CI, install scripts, or build config changed but docs weren't updated
  if git diff --name-only "$range" -- .github/ .goreleaser.yml install.sh install.ps1 Justfile go.mod 2>/dev/null | grep -q .; then
    if ! git diff --name-only "$range" -- README.md docs/ CLAUDE.md 2>/dev/null | grep -q .; then
      echo "CI/scripts/config changed but docs were not updated."
      echo "Update README.md, docs/, or CLAUDE.md before pushing."
      exit 1
    fi
  fi

done

# Install project skills to the Claude user scope.
# Pi is configured by .pi/settings.json to discover ~/.claude/skills.
SKILLS_DEST="$HOME/.claude/skills"
mkdir -p "$SKILLS_DEST"
for skill in roadmap rootline; do
  rm -rf "${SKILLS_DEST:?}/$skill"
  cp -r "$REPO_ROOT/.claude/skills/$skill" "$SKILLS_DEST/$skill"
  echo "rootline: installed $skill skill → $SKILLS_DEST/$skill"
done

# Rebuild rootline binary so the installed version matches the pushed code
ROOTLINE_BIN="${ROOTLINE_BIN:-/usr/local/bin/rootline}"

install_rootline_binary() {
  local version tmp
  version="$(git describe --tags 2>/dev/null || echo dev)"
  tmp="$(mktemp)"

  if ! go build -ldflags "-X main.version=$version" -o "$tmp" ./cmd/rootline/ 2>&1; then
    rm -f "$tmp"
    return 1
  fi

  if [ -w "$ROOTLINE_BIN" ] || { [ ! -e "$ROOTLINE_BIN" ] && [ -w "$(dirname "$ROOTLINE_BIN")" ]; }; then
    install -m 0755 "$tmp" "$ROOTLINE_BIN"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo install -m 0755 "$tmp" "$ROOTLINE_BIN"
  else
    echo "Warning: $ROOTLINE_BIN is not writable and passwordless sudo is unavailable"
    rm -f "$tmp"
    return 1
  fi

  rm -f "$tmp"
}

echo "Rebuilding rootline binary..."
if install_rootline_binary; then
  echo "rootline rebuilt: $("$ROOTLINE_BIN" --version)"
else
  echo "Warning: rootline rebuild failed (push continues)"
fi

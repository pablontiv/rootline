#!/usr/bin/env bash
# Post-merge: install user skills, rebuild binary, propagate aggregates

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Install the project Rootline skill to the Claude user scope.
SKILLS_DEST="$HOME/.claude/skills"
mkdir -p "$SKILLS_DEST"
skill="rootline"
rm -rf "${SKILLS_DEST:?}/$skill"
cp -r "$REPO_ROOT/.claude/skills/$skill" "$SKILLS_DEST/$skill"
echo "rootline: installed $skill skill → $SKILLS_DEST/$skill"

# Rebuild rootline binary so the installed version matches the pulled code
ROOTLINE_BIN="${ROOTLINE_BIN:-/usr/local/bin/rootline}"

install_rootline_binary() {
  local version tmp
  version="$(git describe --tags 2>/dev/null || echo dev)"
  tmp="$(mktemp)"

  if ! go build -ldflags "-X main.version=$version" -o "$tmp" ./cmd/rootline/ 2>&1; then
    rm -f "$tmp"
    return 1
  fi

  if [ -w "$ROOTLINE_BIN" ] || { [ ! -e "$ROOTLINE_BIN" ] && [ -w "$(dirname "$ROOTLINE_BIN")" ]; }; then
    install -m 0755 "$tmp" "$ROOTLINE_BIN"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo install -m 0755 "$tmp" "$ROOTLINE_BIN"
  else
    echo "Warning: $ROOTLINE_BIN is not writable and passwordless sudo is unavailable"
    rm -f "$tmp"
    return 1
  fi

  rm -f "$tmp"
}

echo "Rebuilding rootline binary..."
if install_rootline_binary; then
  echo "rootline rebuilt: $("$ROOTLINE_BIN" --version)"

  # Propagate aggregate values after merge (fix stale parent READMEs)
  "$ROOTLINE_BIN" fix --all "$REPO_ROOT/docs/epics/" 2>/dev/null || true
else
  echo "Warning: rootline rebuild failed"
fi

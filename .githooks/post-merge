#!/usr/bin/env bash
# Post-merge: install user skills, rebuild binary, propagate aggregates

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Install the project Rootline skill to the Claude user scope.
SKILLS_DEST="$HOME/.claude/skills"
mkdir -p "$SKILLS_DEST"
skill="rootline"
rm -rf "${SKILLS_DEST:?}/$skill"
cp -r "$REPO_ROOT/.claude/skills/$skill" "$SKILLS_DEST/$skill"
echo "rootline: installed $skill skill → $SKILLS_DEST/$skill"

# Rebuild the rootline binary so the installed version matches the pulled code.
# Delegate to `just install` — the single source of truth for install destination
# (~/.local/bin) and version scheme (<tag>+local.<sha>). Non-fatal: a failed
# rebuild must never break the merge.
echo "Rebuilding rootline binary..."
if command -v just >/dev/null 2>&1; then
  if ( cd "$REPO_ROOT" && just install ); then
    # Propagate aggregate values after merge (fix stale parent READMEs).
    rootline fix --all "$REPO_ROOT/docs/roadmap/" 2>/dev/null || true
  else
    echo "Warning: just install failed (merge continues)"
  fi
else
  echo "Warning: just not found; skipping rootline reinstall"
fi

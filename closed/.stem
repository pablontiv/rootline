version: 2
schema:
    tipo:
        type: enum
        values: [question, field-log, closure]
        required: true
    estado:
        type: enum
        values: [active, paused, closed]
    tipo_entendimiento:
        type: enum
        values: [describe, understand, explore, build]
    fecha_inicio:
        type: string
    fecha_cierre:
        type: string
    linea:
        type: string
    ciclos_registrados:
        type: integer
    ciclos_completados:
        type: integer
    teoria_emergente:
        type: string

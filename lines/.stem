version: 2
schema:
    tipo:
        type: enum
        enum: [question, field-log]
        required: true
    estado:
        type: enum
        enum: [active, paused, closed]
    tipo_entendimiento:
        type: enum
        enum: [describe, understand, explore, build]
    fecha_inicio:
        type: string
    linea:
        type: string
    ciclos_registrados:
        type: integer
